# Copy to .env.local and fill in. Never commit .env.local.
# Leave everything empty to run the demo on fictional data.

# Database (Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Login (generate each with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Sync and backfill
CRON_SECRET=
DASHBOARD_BASE_URL=http://localhost:3000

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional modules: only what you switched on in dashboard.config.ts
MERCHANT_REFRESH_TOKEN=
MSADS_CLIENT_ID=
MSADS_CLIENT_SECRET=
MSADS_DEVELOPER_TOKEN=
MSADS_REFRESH_TOKEN=
GOOGLE_SHEETS_SERVICE_ACCOUNT_B64=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
ESCALATION_MAIL_FROM=
ESCALATION_MAIL_TO=
